# HomeEase Environment Configuration

# Authorized Administrator Email Configuration (Only this specific email can access /admin)
ADMIN_EMAIL=your-admin-email@example.com
VITE_ADMIN_EMAIL=your-admin-email@example.com

# Initial Administrator Password (used by seed script to securely provision the admin user)
ADMIN_PASSWORD=YourSecurePassword123!

# Token Signing Secret for Server-side Session Management
ADMIN_TOKEN_SECRET=your_super_secure_random_token_secret_here

# Supabase Project URL and Anon API Key (Optional)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Google Maps Platform Browser-Restricted API Key
# Required APIs: Maps JavaScript API, Places API (New), Geocoding API
# Refer to GOOGLE_MAPS_SETUP.md for step-by-step Google Cloud configuration
VITE_GOOGLE_MAPS_API_KEY=

# Note: If Supabase or Google Maps keys are not set, HomeEase automatically runs in
# high-fidelity local demo mode with full offline state persistence (localStorage)
# and interactive Gujarat service area maps, allowing instant testing of all features.
